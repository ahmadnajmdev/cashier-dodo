{
    "name": "ahmadnajmdev/cashier-dodo",
    "description": "Laravel Cashier for Dodo Payments — expressive, fluent billing for subscriptions and one-time payments.",
    "keywords": [
        "laravel",
        "cashier",
        "dodo",
        "dodopayments",
        "billing",
        "subscriptions",
        "payments",
        "merchant of record"
    ],
    "license": "MIT",
    "homepage": "https://github.com/ahmadnajmdev/cashier-dodo",
    "support": {
        "issues": "https://github.com/ahmadnajmdev/cashier-dodo/issues",
        "source": "https://github.com/ahmadnajmdev/cashier-dodo"
    },
    "authors": [
        {
            "name": "Ahmad Najm",
            "email": "ahmadnajim66@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "moneyphp/money": "^4.0",
        "nesbot/carbon": "^2.0|^3.0",
        "standard-webhooks/standard-webhooks": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-intl": "Required for Cashier::formatAmount() to localise currency for display."
    },
    "autoload": {
        "psr-4": {
            "Ahmadnajmdev\\Cashier\\Dodo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmadnajmdev\\Cashier\\Dodo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmadnajmdev\\Cashier\\Dodo\\CashierServiceProvider"
            ],
            "aliases": {
                "Dodo": "Ahmadnajmdev\\Cashier\\Dodo\\Facades\\Dodo"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
